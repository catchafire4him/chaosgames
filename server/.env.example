# Copy to server/.env and fill in. All optional except where noted.
GEMINI_API_KEY=            # omit for the keyless canned host + browser TTS
PORT=4321

# ── Provider selection (each defaults sensibly from the presence of a key) ──
# DIRECTOR=gemini|mock
# SPEAKER=gemini|none
# ARTIST=gemini|none        # Campaign live art (gemini-3.1-flash-lite-image)

# ── Campaign persistence (Neon Postgres) ──
# STORAGE=postgres|memory   # defaults to postgres when DATABASE_URL is set
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
#   Get this from the Neon dashboard (project: chaosgames). In production set
#   it in the Railway dashboard — never pass secrets as CLI arguments.

# ── Production only ──
# PUBLIC_URL=https://chaosgames-production.up.railway.app
